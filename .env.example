# Bagdja Auth API and SSO login frontend
BAGDJA_AUTH_URL=http://localhost:4001
BAGDJA_LOGIN_URL=https://login.bagdja.com
CLIENT_APP_ID=bagdja-website-platform
CLIENT_APP_SECRET=replace-with-the-registered-client-secret

# Public URL used to build the OAuth callback URI.
BAGDJA_APP_URL=http://localhost:5006

# Website API server-side origin for persistent access requests and invitations.
BAGDJA_WEBSITE_API_URL=http://localhost:5003

# Public Event Service URL used by the inbox WebSocket client.
# Production: https://event.bagdja.com
NEXT_PUBLIC_EVENT_API=http://localhost:4085

# Required in production for one-time OAuth state storage.
# Local development can use the in-memory fallback.
# Vercel + integrasi Upstash: KV_REST_API_URL / KV_REST_API_TOKEN juga diterima.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Renderer website tenant (tautan website uji di halaman Tim penguji)
NEXT_PUBLIC_WEB_URL=http://localhost:5005
